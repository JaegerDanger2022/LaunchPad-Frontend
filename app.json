{
  "expo": {
    "name": "PacksLight---Expo-Frontend",
    "slug": "PacksLight---Expo-Frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#FF6B35",
          "sounds": []
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "We need microphone access to record voice messages about your dreams"
        }
      ]
    ],
    "notification": {
      "color": "#FF6B35",
      "androidMode": "default"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.packslight.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We need microphone access to record voice messages about your dreams"
      }
    },
    "android": {
      "package": "com.packslight.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "useNextNotificationsApi": true,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
    }
  }
}
