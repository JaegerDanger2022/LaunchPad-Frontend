{
  "expo": {
    "name": "LaunchPad",
    "slug": "launchpad",
    "scheme": "launchpad",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050938"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35",
          "sounds": [],
          "mode": "production"
        }
      ],
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "We need microphone access to record voice messages about your dreams"
        }
      ]
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FF6B35",
      "androidMode": "default"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capstone.launchpad",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "We need microphone access to record voice messages about your dreams"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050938"
      },
      "package": "com.capstone.launchpad",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {},
    "extra": {
      "eas": {
        "projectId": "b61e2f3e-f9e0-48b4-9e8c-22c94b9828b9"
      }
    },
    "owner": "expocapstone",
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/b61e2f3e-f9e0-48b4-9e8c-22c94b9828b9"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
