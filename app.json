{
  "expo": {
    "name": "LaunchPad",
    "slug": "launchpad",
    "scheme": "launchpad",
    "version": "0.11",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#050938"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FF6B35",
          "sounds": [],
          "mode": "production"
        }
      ],
      "./plugins/removeMediaPlaybackPermission.js",
      "expo-asset"
    ],
    "notification": {
      "icon": "./assets/notification-icon.png",
      "color": "#FF6B35",
      "androidMode": "default"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.capstone.launchpad.app",
      "icon": "./assets/icon.png"
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050938"
      },
      "package": "com.capstone.launchpad.app",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {},
    "owner": "capstonesolutions28",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "ef3df6f3-7491-4b4d-a230-e3288bb64014",
        "REVENUECAT_API_KEY": "goog_iotUTNDuCAKYkLQEGpQkEeVnqyz",
        "EXPO_PUBLIC_REVENUECAT_API_KEY": "goog_iotUTNDuCAKYkLQEGpQkEeVnqyz"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ef3df6f3-7491-4b4d-a230-e3288bb64014"
    }
  }
}
